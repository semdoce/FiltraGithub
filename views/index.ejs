<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Commit Checker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #f9fafb; 
            color: #1f2937; 
            margin: 0; 
            padding: 20px; 
            display: flex; 
            flex-direction: column; 
            align-items: center;
        }
        .container {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            margin-top: 40px;
            box-sizing: border-box;
        }
        h1 {
            font-size: 24px;
            font-weight: 600;
            margin-top: 0;
            margin-bottom: 24px;
            text-align: center;
            color: #111827;
        }
        .form-group { margin-bottom: 20px; }
        input[type="text"] {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 15px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            font-family: inherit;
        }
        input[type="text"]:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }
        input[type="text"]::placeholder {
            color: #9ca3af;
        }
        button[type="submit"] {
            width: 100%;
            background-color: #6366f1;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            font-family: inherit;
            margin-top: 10px;
        }
        button[type="submit"]:hover {
            background-color: #4f46e5;
        }
        .error { 
            color: #ef4444; 
            background-color: #fef2f2;
            padding: 12px;
            border-radius: 8px;
            font-size: 14px;
            margin-bottom: 20px;
            border: 1px solid #fecaca;
        }
        
        /* Resultados Styles */
        .results-container {
            width: 100%;
            max-width: 800px;
            margin-top: 30px;
        }
        h2 {
            font-size: 18px;
            color: #374151;
            margin-bottom: 16px;
            font-weight: 500;
            text-align: center;
        }
        .summary-box {
            background-color: #f0fdf4;
            padding: 20px;
            border: 1px solid #bbf7d0;
            border-radius: 12px;
            margin-bottom: 24px;
        }
        .summary-box h3 {
            margin-top: 0;
            color: #166534;
            font-size: 16px;
            margin-bottom: 8px;
        }
        .summary-box p {
            margin-bottom: 0;
            line-height: 1.6;
            color: #15803d;
            font-size: 15px;
        }
        .commit-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .commit-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .commit-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 14px;
            color: #6b7280;
        }
        .commit-sha {
            font-family: monospace;
            background-color: #f3f4f6;
            padding: 2px 6px;
            border-radius: 4px;
            color: #374151;
        }
        .commit-message {
            font-size: 15px;
            color: #111827;
            margin-bottom: 12px;
            line-height: 1.5;
        }
        .commit-link {
            color: #6366f1;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }
        .commit-link:hover {
            text-decoration: underline;
        }
        .empty-state {
            text-align: center;
            color: #6b7280;
            padding: 40px 0;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Buscar Commits</h1>
        
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="/search" method="GET">
            <div class="form-group">
                <input type="text" name="repoUrl" required placeholder="Link do repositório (ex: facebook/react)" value="<%= typeof search !== 'undefined' ? search.repoUrl : '' %>">
            </div>
            <div class="form-group">
                <input type="text" name="username" required placeholder="Nome de usuário (ex: gaearon)" value="<%= typeof search !== 'undefined' ? search.username : '' %>">
            </div>
            <button type="submit">Continuar</button>
        </form>
    </div>

    <% if (typeof commits !== 'undefined' && commits && commits.length > 0) { %>
        <div class="results-container">
            <h2>Resultados para <strong><%= search.username %></strong> no repositório <strong><%= search.owner %>/<%= search.repo %></strong></h2>
            
            <% if (summary) { %>
                <div class="summary-box">
                    <h3>✨ Resumo da IA (Gemini)</h3>
                    <p><%= summary %></p>
                </div>
            <% } %>

            <div class="commit-list">
                <% commits.forEach(commit => { %>
                    <div class="commit-card">
                        <div class="commit-header">
                            <span class="commit-sha"><%= commit.sha %></span>
                            <span class="commit-date"><%= commit.date %></span>
                        </div>
                        <div class="commit-message"><%= commit.message %></div>
                        <a href="<%= commit.url %>" target="_blank" class="commit-link">Ver no GitHub &rarr;</a>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } else if (typeof commits !== 'undefined' && commits && commits.length === 0) { %>
        <div class="results-container">
            <div class="empty-state">
                Nenhum commit encontrado para este usuário nas últimas 100 atividades.
            </div>
        </div>
    <% } %>
</body>
</html>
